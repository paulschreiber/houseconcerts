<div class="show">
  <%= ld_json_tag(ld_json_event(show)) %>
  <%# priority: this show is the page's main image, so its first photo is fetched first. %>
  <% show.artists.each_with_index do |artist, index| %>
    <% photo = image_tag("/#{artist.photo}", class: "artist", width: 200, height: 220, alt: artist.name,
                                              fetchpriority: ("high" if priority && index.zero?)) %>
    <%= link_to_unless show.sold_out?, photo, rsvp_for_show_path(slug: show.slug), class: "imagelink" %>  <% end %>
  <% if mode == :index %>
    <h2><%= show.name %></h2>
  <% end %>

  <p><%= show.blurb %></p>

  <time datetime="<%= show.start.iso8601 %>"><%= show.start_date %><br />
    <%= show.start_time %></time>
  <% if mode == :detail %>
    <p>$<%= show.price %></p>
  <% end %>

  <% if show.confirmed? %>
    <% if show.sold_out? %>
      <p>This show is sold out.</p>
    <% else %>
      <% if show.waitlisted? %>
        <p><em>This show is sold out. Please RSVP now to be added to the waiting list.</em></p>
      <% end %>
      <p><%= button_to("Reserve Seats", rsvp_for_show_path(slug: show.slug), method: :get) unless controller_name == "rsvps" %></p>
    <% end %>
  <% end %>
</div>
