<h2>Passkeys</h2>

<% if @passkeys.any? %>
  <table class="passkeys">
    <thead>
      <tr><th>Name</th><th>Added</th><th></th></tr>
    </thead>
    <tbody>
      <% @passkeys.each do |passkey| %>
        <tr>
          <td><%= passkey.name %></td>
          <td><%= passkey.created_at.to_fs(:long) %></td>
          <td><%= button_to "Remove", admin_passkey_path(passkey), method: :delete, form: { data: { turbo_confirm: "Remove the passkey “#{passkey.name}”?" } } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p>If you don't recognize a passkey, remove it and reset your password.</p>
<% else %>
  <p>You don't have any passkeys yet.</p>
<% end %>

<h3>Add a passkey</h3>

<%= passkey_creation_form_for(resource_name, class: "passkey-form") do |form| %>
  <div>
    <%= form.label :name, "Passkey name" %>
    <%= form.text_field :name, required: true %>
  </div>
  <div>
    <%= label_tag :current_password, "Current password" %>
    <%= password_field_tag :current_password, nil, required: true, autocomplete: "current-password" %>
  </div>
  <div>
    <%= form.submit "Create Passkey" %>
  </div>
<% end %>
