<%
  # Overridden only to inject the shared admin <header> below, matching
  # madmin's own -- Mission Control has no config hook for that. Everything
  # else here (including the "Back to main app" link, driven by the
  # back_to_main_app_path config in config/initializers/mission_control_jobs.rb)
  # is kept identical to the gem's own partial so it doesn't silently drift.
%>
<%= stylesheet_link_tag "mission_control_custom", "data-turbo-track": "reload" %>

<header id="navbar">
  <div class="nav-group">
    <%= link_to Madmin.site_name, main_app.madmin_root_path(server_id: nil), data: { turbo: false } %>
  </div>
</header>

<nav class="navbar" role="navigation" aria-label="main navigation">
  <div class="navbar-menu is-active mb-4">
    <div class="navbar-start">
      <% if (path = back_to_main_app_path) %>
        <%= link_to "Back to main app", path %>
      <% end %>
    </div>

    <div class="navbar-end">
      <%= render "layouts/mission_control/jobs/application_selection/servers", application: @application %>
      <%= render "layouts/mission_control/jobs/application_selection/applications" if selectable_applications.any? %>
    </div>
  </div>
</nav>
