<%# A form's validation errors, above its fields. Some validations share a
    message (a blank name is also too short), so each is listed once. %>
<% if record.errors.any? %>
  <% messages = record.errors.full_messages.uniq %>
  <div class="alert alert-danger form-errors">
    <div><%= t("madmin.form.errors", count: messages.count) %>:</div>

    <ul>
      <% messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
