<%# A layout for a form's fields that lists, above them, the validation errors
    no field shows (form_error.rb): those of a field that opts out of inline
    messages, such as an artist's photo, and ones with no field of their own.
    The fields render first, so it knows which those are. Some validations
    share a message, so each is listed once. %>
<% fields = yield %>
<% inline = @inline_error_attributes.to_h[record] || Set.new %>
<% messages = record.errors.reject { inline.include?(_1.attribute.to_s) }.map(&:full_message).uniq %>
<% if messages.any? %>
  <div class="alert alert-danger form-errors">
    <div><%= t("madmin.form.errors", count: messages.count) %>:</div>

    <ul>
      <% messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<%= fields %>
