<nav>
  <%= nav_link_to t("madmin.navigation.dashboard"), madmin_root_path %>

  <% Madmin.menu.render do |item| %>
    <% if item.url %>
      <%= nav_link_to item.label, item.url, starts_with: item.url %>
    <% else %>
      <h4><%= item.label %></h4>
    <% end %>

    <% item.items.each do |item| %>
      <%= nav_link_to item.label, item.url, starts_with: item.url %>
    <% end %>
  <% end %>

  <%= link_to "Sign out", destroy_admin_session_path, data: { turbo_method: :delete } %>
</nav>
