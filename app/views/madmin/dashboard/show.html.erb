<h1><%= Settings.site_name %></h1>

<% if @failed_batch_items.any? %>
  <div class="dashboard-warning">
    <h2>Failed sends need attention</h2>
    <ul>
      <% @failed_batch_items.group_by(&:batch_run).each do |batch_run, items| %>
        <li>
          <%= link_to batch_run.show.name, madmin_show_path(batch_run.show) %> &mdash; <%= BatchRun.kind_label(batch_run.kind) %>:
          <%= items.size %> failed <%= items.size == 1 ? "send" : "sends" %>
          <%= button_to "Retry", retry_failed_batch_run_madmin_show_path(batch_run.show, batch_run_id: batch_run.id), method: :patch, class: "btn btn-secondary" %>
          <ul class="dashboard-warning-reasons">
            <% items.filter_map(&:error_message).uniq.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
