<%# A copy of Madmin 3.4.1's has_many field form, with the association's
    errors added after the select. %>
<%= form.select "#{field.attribute_name.to_s.singularize}_ids", field.options_for_select(record), { prompt: true }, { multiple: true, class: "form-input", data: { controller: "select", select_url_value: field.index_path } } %>
<%= render "madmin/application/association_errors", field: field, record: record %>
