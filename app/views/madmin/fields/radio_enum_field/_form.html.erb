<div class="radio-group">
  <% field.options_for_select(record).each do |option| %>
    <label class="radio-group__option">
      <%= form.radio_button field.attribute_name, option %>
      <%= option.to_s.humanize %>
    </label>
  <% end %>
</div>
<% if field.options[:hint] %>
  <small><%= field.options[:hint].call %></small>
<% end %>
