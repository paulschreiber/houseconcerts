<% locked = @invite_message.locked? %>
<% actions = capture do %>
  <%= render "edit_button", invite_message: @invite_message, locked: %>
  <%= button_to "Send Test", send_test_madmin_show_invite_message_path(@show, @invite_message), class: "btn btn-secondary" %>
  <%= link_to "New Revision", new_madmin_show_invite_message_path(@show), class: "btn btn-secondary" %>
  <%= link_to "History", madmin_show_invite_messages_path(@show), class: "btn btn-secondary" %>
  <%= render "delete_button", invite_message: @invite_message unless locked %>
<% end %>
<%= render "header", title: "Invite, Revision #{@invite_message.revision}", actions: %>

<p class="invite-status">
  <%= render "status", invite_message: @invite_message, locked:, current: @invite_message.current? %>
</p>

<iframe src="<%= preview_madmin_show_invite_message_path(@show, @invite_message) %>" title="Revision <%= @invite_message.revision %>" class="invite-preview-frame"></iframe>
