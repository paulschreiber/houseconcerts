<fieldset>
  <legend><%= t("madmin.settings.groups.defaults") %></legend>
  <div class="form-group">
    <%= form.label :default_country %>
    <%= form.select :default_country, Carmen::Country.all.map { |country| [ country.name, country.code ] }.sort, {}, class: "form-input" %>
    <div class="form-description"><%= t("madmin.settings.help.default_country") %></div>
  </div>
  <div class="form-group">
    <%= form.label :default_venue_group %>
    <%= form.select :default_venue_group, VenueGroup.order(:name).map { |group| [ group.name, group.id ] }, {}, class: "form-input" %>
  </div>
</fieldset>

<fieldset>
  <legend><%= t("madmin.settings.groups.time_zone") %></legend>
  <div class="form-group">
    <%= form.label :time_zone %>
    <%= form.time_zone_select :time_zone, ActiveSupport::TimeZone.us_zones, {}, class: "form-input" %>
    <div class="form-description"><%= t("madmin.settings.help.time_zone") %></div>
  </div>
</fieldset>
