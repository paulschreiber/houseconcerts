<%# The running-state failed count/button below is queried live rather
    than trusting batch_run.failed_count: that cached column is only
    ever refreshed as part of some item's own record_progress call, so
    a batch_run row read at just the wrong moment (e.g. right after an
    item fails, before its own recompute reaches this field) could
    still show a stale count here. The completed-state count doesn't
    need this -- once a run is completed, nothing changes its counters
    again, so it's always accurate by then. %>
<% failed_count = batch_run.completed? ? batch_run.failed_count : batch_run.batch_run_items.failed.count %>
<div id="batch_run_progress_<%= batch_run.kind %>" class="batch-progress-status">
  <% if batch_run.completed? %>
    <%= batch_run.sent_count %> sent<% if failed_count.positive? %>, <%= failed_count %> failed<% end %> (complete)
  <% else %>
    <progress value="<%= batch_run.processed_count %>" max="<%= [ batch_run.total_count, 1 ].max %>"></progress>
    <%= batch_run.sent_count %>/<%= batch_run.total_count %> sent<% if failed_count.positive? %>, <%= failed_count %> failed<% end %>
    (<%= batch_run.status.humanize %>)
  <% end %>
  <% if failed_count.positive? && !batch_run.show.occurred? %>
    <%= render "madmin/shows/retry_button", batch_run:, label: "Retry #{failed_count} failed" %>
  <% end %>
  <% unless batch_run.completed? %>
    <%= button_to "Cancel", cancel_batch_run_madmin_show_path(batch_run.show, batch_run_id: batch_run.id), method: :patch, class: "btn btn-secondary",
                            data: { turbo_confirm: "Cancel this batch? Sends already in progress may still go out, but nothing still waiting to start will be sent." } %>
  <% end %>
</div>
