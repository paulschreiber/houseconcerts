<h1>Rejoin the mailing list</h1>

<div class="pagetext">
<% if @person.active? %>
<p><%= @person.first_name %>, you’re already on my mailing list.</p>
<% else %>
<p><%= @person.first_name %>, confirm you’d like to be added back to my mailing list.</p>
<%= button_to "Add me back to the mailing list", mailing_list_rejoin_path(uniqid: @person.uniqid) %>
<% end %>
</div>
