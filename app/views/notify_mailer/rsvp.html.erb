<h1><%= @subject %></h1>

<table class="details">
  <tr><th>Show</th><td><%= @rsvp.show %></td></tr>
  <tr><th>Person</th><td><%= @rsvp.full_name %></td></tr>
<%- if @rsvp.response != "yes" %>
  <tr><th>Response</th><td><%= @rsvp.response %></td></tr>
<%- end -%>
<%- if @old_seats.nil? and @rsvp.seats_reserved > 0 %>
  <tr><th>Seats</th><td><%= @rsvp.seats_reserved %></td></tr>
<%- elsif !@old_seats.nil? %>
  <tr><th>Seats</th><td><%= @old_seats %> → <%= @rsvp.seats_reserved %></td></tr>
<%- end -%>
  <tr><th>On mailing list</th><td><%= @rsvp.person_exists? ? "Yes" : "No" %></td></tr>
</table>

<%- if @rsvp.response == "yes" -%>
<h2>Attendance History</h2>
<%- if @history.any? %>
<table class="history">
  <thead>
    <tr><th>Date</th><th>Show</th><th>Seats used</th></tr>
  </thead>
  <tbody>
  <%- @history.each do |kind, past_rsvp| %>
    <%- if kind == :cancelled -%>
    <tr>
      <td><%= past_rsvp.start.to_date.iso8601 %></td>
      <td><%= past_rsvp.name %></td>
      <td class="empty">Cancelled <%= past_rsvp.cancelled_at.to_date.iso8601 %></td>
    </tr>
    <%- else -%>
    <%= tag.tr(class: ("unused-seats" if past_rsvp.seats_used.to_i < past_rsvp.seats_reserved.to_i)) do %>
      <td><%= past_rsvp.start.to_date.iso8601 %></td>
      <td><%= past_rsvp.name %></td>
      <td><%= past_rsvp.seats_used.to_i %> / <%= past_rsvp.seats_reserved.to_i %></td>
    <%- end -%>
    <%- end -%>
  <%- end -%>
  </tbody>
</table>
<%- else -%>
<p class="empty">No previous reservations.</p>
<%- end -%>
<%- end -%>
