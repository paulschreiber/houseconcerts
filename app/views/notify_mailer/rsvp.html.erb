<h1><%= @subject %></h1>

<p>Show: <%= @rsvp.show %></p>

<p>Person: <%= @rsvp.full_name %>
<%- if @rsvp.response != "yes" %>
<br>Response: <%= @rsvp.response %>
<%- end -%>
<%- if @old_seats.nil? and @rsvp.seats_reserved > 0 %>
<br>Seats: <%= @rsvp.seats_reserved %>
<%- elsif !@old_seats.nil? %>
<br>Seats: <%= @old_seats %> → <%= @rsvp.seats_reserved %>
<%- end -%>
<br>On mailing list: <%= @rsvp.person_exists? ? "Yes" : "No" %>
</p>

<h2>Attendance History</h2>
<%- if @shows_attended.any? %>
<ul>
  <%- @shows_attended.each do |show| %>
    <%- my_tag = show.seats_used.to_i < show.seats_reserved.to_i ? "strong" : "span" -%>

    <li>
        <%= tag.public_send(my_tag) do %>
          <%= show.start.to_date.iso8601 %>:
          <%= show.name %>
          (<%= show.seats_used.to_i %> / <%= show.seats_reserved.to_i %>)
        <%- end -%>
    </li>
  <%- end -%>
</ul>
<%- else -%>
<p>No previous reservations.</p>
<%- end -%>
