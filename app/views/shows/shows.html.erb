<% content_for :title, page_title("Past Shows") %>

<h1>Past shows</h1>

<div class="pagetext shows">

<% if @shows.empty? %>
<h2>No shows found</h2>
<p>No past shows were found.</p>
<% else %>

<ol class="columnheads">
<li><h3>Musician</h3><h3>Date</h3></li>
<li><h3>Musician</h3><h3>Date</h3></li>
<li><h3>Musician</h3><h3>Date</h3></li>
</ol>

<ol class="vcalendar">

	<% @shows.each do |show| %>

		<%
			artist_for_photo = show.artists.sample
			next unless artist_for_photo
			artist_links = show.artists.map do |artist|
				if artist.url?
					link_to(artist.name, artist.url, class: "url fn")
				else
					content_tag(:span, artist.name, class: "fn")
				end
			end
		%>

		<li class='vevent'>
		<div class='vcard attendee summary'>

			<% photo = tag.img(class: "artist photo", src: "/photos/headshots/thumb/#{artist_for_photo.slug}.jpg", width: 50, height: 50, alt: artist_for_photo.name) %>
			<%= artist_for_photo.url? ? link_to(photo, artist_for_photo.url, class: "imagelink") : photo %>

			<%= artist_links.to_sentence.html_safe %>

		</div>

		<abbr class='dtstart' title='<%= show.start.to_time.iso8601 %>'><%= show.start.strftime("%B %e, %Y").strip %></abbr>

		</li>

		<% end # shows.each %>

</ol>

<% end %>


</div>
