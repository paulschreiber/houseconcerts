# Solid Queue worker for houseconcerts, run outside of Passenger since
# Passenger only manages the web process, not background workers.
#
# It runs as its own unprivileged user (houseconcerts-jobs), not the deploy
# user. Before installing this unit, create that user and set up the shared
# file permissions once with:
#   sudo bash /data/sites/houseconcerts/current/config/deploy/setup_solidqueue_user.sh
#
# Install on the server:
#   sudo cp config/deploy/templates/houseconcerts-solidqueue.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now houseconcerts-solidqueue
#
# Also requires passwordless sudo for the deploy user to restart this
# service from the "solid_queue:restart" Capistrano task in deploy.rb:
#   paul ALL=(ALL) NOPASSWD: /bin/systemctl restart houseconcerts-solidqueue
#
# The sandboxing below makes everything read-only except the shared log and
# tmp directories, and hides /home (see the script above if Ruby or gems live
# there).
#
# After changing this file on the server, check it with:
#   sudo systemd-analyze verify /etc/systemd/system/houseconcerts-solidqueue.service
#   sudo systemd-analyze security houseconcerts-solidqueue

[Unit]
Description=Solid Queue for houseconcerts
After=network.target mysql.service

[Service]
Type=simple
User=houseconcerts-jobs
Group=houseconcerts
WorkingDirectory=/data/sites/houseconcerts/current
Environment=RAILS_ENV=production
Environment=BOOTSNAP_CACHE_DIR=/data/sites/houseconcerts/shared/tmp/cache
ExecStart=/usr/bin/ruby bin/jobs
Restart=always
RestartSec=1

# Sandboxing
# Group-writable, so log files the worker creates stay writable for the web app
# (which runs as the deploy user, also in the houseconcerts group).
UMask=0002
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data/sites/houseconcerts/shared/log /data/sites/houseconcerts/shared/tmp
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
