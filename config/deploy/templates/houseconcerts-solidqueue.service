# Solid Queue worker for houseconcerts, run outside of Passenger since
# Passenger only manages the web process, not background workers.
#
# It runs as its own unprivileged user (houseconcerts-jobs), not the deploy
# user (houseconcerts-deploy). Before installing this unit, create both users
# and set up the shared file permissions once with setup_deploy_user.sh and
# setup_solidqueue_user.sh (see "Server" in INFRASTRUCTURE.md).
# setup_deploy_user.sh also lets the deploy user restart this service, for
# the "solid_queue:restart" Capistrano task in deploy.rb.
#
# Install on the server, from a copy of this file:
#   sudo cp houseconcerts-solidqueue.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable houseconcerts-solidqueue
#   sudo systemctl restart houseconcerts-solidqueue
#
# The sandboxing below makes everything read-only except the shared log
# directory and the worker's cache directory (/var/cache/houseconcerts-jobs,
# which systemd creates). It also hides /home: if Ruby or any gems live there
# (e.g. rbenv in the deploy user's home), change ProtectHome=yes to
# ProtectHome=read-only.
#
# After changing this file on the server, check it with:
#   sudo systemd-analyze verify /etc/systemd/system/houseconcerts-solidqueue.service
#   sudo systemd-analyze security houseconcerts-solidqueue

[Unit]
Description=Solid Queue for houseconcerts
After=network.target mysql.service

[Service]
Type=simple
User=houseconcerts-jobs
Group=houseconcerts
WorkingDirectory=/data/sites/houseconcerts/current
Environment=RAILS_ENV=production
Environment=BOOTSNAP_CACHE_DIR=/var/cache/houseconcerts-jobs
CacheDirectory=houseconcerts-jobs
ExecStart=/usr/bin/ruby bin/jobs
Restart=always
RestartSec=1

# Sandboxing
# Group-writable, so log files the worker creates stay writable for the web app
# (which runs as the deploy user, also in the houseconcerts group), and not
# readable by anyone else.
UMask=0007
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data/sites/houseconcerts/shared/log
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
